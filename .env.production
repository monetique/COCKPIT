# ── PostgreSQL (conteneur interne) ─────────────────────────
PG_HOST=postgres          # NE PAS CHANGER — nom du service Docker
PG_PORT=5432
PG_DATABASE=clictopay_db
PG_USER=postgres
PG_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE
PG_SSL=false

# ── JWT ────────────────────────────────────────────────────
# Régénérer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_CE_SECRET_JWT_EN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

